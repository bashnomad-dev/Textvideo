# Telegram Bot Token (получить у @BotFather)
TRANSCRIBER_BOT_TOKEN=

# Транскрибация — один из двух:
# Groq (бесплатный, рекомендуется): https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI (платный): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Провайдер транскрибации: groq или openai
TRANSCRIBE_PROVIDER=groq

# Саммаризация: требует OPENAI_API_KEY (выше). Без него бот шлёт только транскрипт.
SUMMARY_MODEL=gpt-4o

# YouTube-субтитры через Supadata: https://supadata.ai
SUPADATA_API_KEY=

# Макс. размер файла при прямой отправке в чат, МБ.
# Жёсткий потолок Telegram для скачивания ботом — 20 МБ. Файлы крупнее — слать ссылкой.
MAX_FILE_SIZE_MB=20

# Мониторинг (dead-man switch). Создай check на https://healthchecks.io,
# вставь его ping-URL сюда — бот будет пинговать его раз в HEALTHCHECK_INTERVAL сек.
# Если пинги прекратятся (бот упал/завис) — Healthchecks.io пришлёт алерт.
# Пусто — мониторинг выключен.
HEALTHCHECK_URL=
HEALTHCHECK_INTERVAL=60
