# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=

# Транскрибация — один из двух:
# Groq (бесплатный, рекомендуется): https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI (платный): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Провайдер транскрибации: groq или openai
TRANSCRIBE_PROVIDER=groq

# Максимальный размер файла в МБ (по умолчанию 25)
MAX_FILE_SIZE_MB=25
